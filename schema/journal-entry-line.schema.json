{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ZeraBooks/loan-payment-split/main/schema/journal-entry-line.schema.json",
  "title": "Journal entry line",
  "description": "One line of a journal entry CSV. Lines with the same Date and Memo form one entry, which must balance (LOAN-006).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Date",
    "Memo",
    "Account",
    "Debit",
    "Credit"
  ],
  "properties": {
    "Date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "Memo": {
      "type": "string",
      "minLength": 1,
      "description": "Same memo on every line of one entry, e.g. 'Loan payment 3'."
    },
    "Account": {
      "type": "string",
      "minLength": 1,
      "description": "e.g. Loan payable, Interest expense, Bank and loan fees, Cash: checking."
    },
    "Debit": {
      "type": "string",
      "pattern": "^$|^(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "Credit": {
      "type": "string",
      "pattern": "^$|^(0|[1-9][0-9]*)\\.[0-9]{2}$"
    }
  }
}
